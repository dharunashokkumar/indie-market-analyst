# OpenRouter — primary LLM provider
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: for OpenRouter analytics
OPENROUTER_APP_TITLE=indie-market-analyst
OPENROUTER_APP_URL=http://localhost:8000

# App
APP_ENV=dev
LOG_LEVEL=INFO
DB_PATH=sessions/memory.db
RUNS_DIR=runs
CHAT_HISTORY_MESSAGES=20
CHAT_HISTORY_MAX_CHARS=32000

# Disable SDK tracing unless you wire one up
OPENAI_AGENTS_DISABLE_TRACING=1

# Model selection — env is the ONLY source of truth. Use OpenRouter :free slugs
# to avoid burning credits. MODEL_<ROLE> per role; MODEL_DEFAULT is the fallback.
#
# Rule of thumb:
#   • Non-thinking chat models for user-facing roles (clean streaming output).
#   • Avoid R1/Nemotron-style reasoning models for roles that don't have a
#     structured output_type — their CoT leaks into the final answer.
#   • Swap freely; the registry reads whatever is set here.

MODEL_DEFAULT=deepseek/deepseek-chat-v3.1:free
MODEL_ORCHESTRATOR=google/gemini-2.5-flash-free
MODEL_COLLECTOR=meta-llama/llama-3.3-70b-instruct:free
MODEL_VERIFIER=google/gemini-2.5-flash-free
MODEL_CALCULATOR=deepseek/deepseek-chat-v3.1:free
MODEL_REPORT_WRITER=google/gemini-2.5-flash-free
MODEL_EQUITY_RESEARCHER=google/gemini-2.5-flash-free
MODEL_DERIVATIVES_STRATEGIST=google/gemini-2.5-flash-free
MODEL_QUANT_CODER=qwen/qwen-2.5-coder-32b-instruct:free
MODEL_MACRO_ANALYST=meta-llama/llama-3.3-70b-instruct:free
MODEL_GUARDRAIL_VALIDATOR=meta-llama/llama-3.3-70b-instruct:free
MODEL_CONCIERGE=google/gemini-2.5-flash-free
MODEL_PULSE_ANALYST=google/gemini-2.5-flash-free
MODEL_NEWS_ANALYST=google/gemini-2.5-flash-free

# Optional news providers (free tiers, keys are free to register). Leave blank
# to use RSS only — RSS alone is enough and needs no key.
# MARKETAUX_API_KEY=
# NEWSAPI_KEY=

# Playwright news scraper (moneycontrol, livemint, ET, BS, NDTV Profit).
# One-time install after `uv sync`:
#   uv run playwright install chromium
# Set NEWS_PLAYWRIGHT_FALLBACK=0 to force RSS-only (e.g. minimal CI images
# where chromium is not installed). Default is enabled.
NEWS_PLAYWRIGHT_FALLBACK=1
